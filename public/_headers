# Workers Static Assets read this file. Without it, every file is sent with
# max-age=0, so each visit asks the server again for unchanged files.

# Hashed build files never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed: a changed file gets a new name (see next/image cache busting),
# so a week is safe, and the browser checks again in the background.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
