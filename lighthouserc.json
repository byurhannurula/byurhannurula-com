{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3300",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3300/",
        "http://localhost:3300/about",
        "http://localhost:3300/work",
        "http://localhost:3300/uses",
        "http://localhost:3300/cv"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--headless=new" }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
