# Copy to .env.local for development, or to .env.production for the Docker deploy.

# Public site URL (required)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Upstash Redis for post views and likes (optional, features degrade without it)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Umami analytics (optional). Both are needed; the website id turns it on.
# UMAMI_HOST is read at build time to rewrite /stats/* to the analytics host,
# so the scripts load first-party. Reporting is limited to the hostname of
# NEXT_PUBLIC_BASE_URL, and nothing is sent from a dev server.
UMAMI_HOST="https://analytics.blab.party"
NEXT_PUBLIC_UMAMI_ID=""
