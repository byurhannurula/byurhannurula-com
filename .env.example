# Copy to .env.local for local work. Nothing here is needed to build.

# Live origin, no trailing slash. Canonical URLs, sitemap, OG images.
# Unset: http://localhost:3000 (or the Vercel production URL on Vercel).
SITE_URL=

# Homelab status. A public Uptime Kuma status page, for example
# https://status.example.com/status/home. Unset: the page shows sample data.
UPTIME_KUMA_STATUS_URL=

# Umami analytics, production builds only. Inlined at build time.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
