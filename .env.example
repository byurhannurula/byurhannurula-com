# Copy to .env.local for local work. Nothing here is needed to build.

# Live origin, no trailing slash. Canonical URLs, sitemap, OG images.
# Unset: http://localhost:3000 (or the Vercel production URL on Vercel).
SITE_URL=

# Homelab status. A public Uptime Kuma status page, for example
# https://status.example.com/status/home. Unset: the page shows sample data.
UPTIME_KUMA_STATUS_URL=

# Umami analytics. Cookieless, so no consent banner. Production builds only,
# and NEXT_PUBLIC_* values are inlined at build time.
#
# Direct: NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# Proxied through this site (ad blockers skip it): set UMAMI_HOST to the
# Umami origin, e.g. https://cloud.umami.is, and NEXT_PUBLIC_UMAMI_SRC=/stats/script.js
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_HOST=
# Comma list. Only these hosts are counted, so previews and localhost are not.
NEXT_PUBLIC_UMAMI_DOMAINS=

# Views and likes on notes. Upstash Redis REST, the same database as the
# old site (keys post:<slug>:views and :likes). Unset: sample numbers on
# /stats, and the like button shows no count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Amazon Associates tag for the shelf "Buy" links, e.g. byurhan-20.
# Unset: plain links with no tag and no affiliate note.
NEXT_PUBLIC_AMAZON_TAG=
